{% set isBlogPage = (page.url == '/en/posts/') %}

{% if isBlogPage %}

<section class="post-grid">
  {% for post in postslist %}
    {% if not post.data.hide %}
      <article class="post-card">
        <a href="{{ post.url | url }}" class="post-card__media" tabindex="-1" aria-hidden="true">
          {% if post.data.image %}
            <img src="{{ post.data.image | url }}" alt="" loading="lazy">
          {% endif %}
        </a>

        <h3 class="post-card__title">
          <a href="{{ post.url | url }}">
            {% if post.data.title %}{{ post.data.title }}{% else %}Untitled{% endif %}
          </a>
        </h3>

        {% if post.data.summary %}
          <p class="post-card__summary">{{ post.data.summary }}</p>
        {% endif %}

        <p class="post-card__meta">
          <time>{{ post.data.date | readableDate }}</time>
          {% if post.data.author %}<span class="post-author">&middot; {{ post.data.author }}</span>{% endif %}
        </p>

        <div class="post-card__tags">
          {% for tag in post.data.tags %}
            {% if tag != 'post' %}
              <a href="{{ '/en/tags/' | url }}{{ tag | slug }}/" class="post-card__tag">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </article>
    {% endif %}
  {% endfor %}
</section>

<style>
.post-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rem 1.5rem;
  margin: 1.5rem 0 2rem;
}

.post-card {
  display: flex;
  flex-direction: column;
}

.post-card__media {
  display: block;
  aspect-ratio: 3 / 2;
  background: #e8f6fd;
  overflow: hidden;
}

.post-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.25s ease;
}

.post-card:hover .post-card__media img {
  transform: scale(1.04);
}

.post-card__title {
  margin: 0.75rem 0 0.4rem;
  font-size: 1.15rem;
  line-height: 1.3;
  font-weight: 700;
}

.post-card__title a {
  color: inherit;
  text-decoration: none;
  font-weight: inherit;
}

.post-card__title a:hover {
  color: #00adef;
  text-decoration: underline;
}

.post-card__summary {
  margin: 0 0 0.5rem;
  font-size: 0.9rem;
  line-height: 1.45;
  color: #555;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card__meta {
  margin: 0 0 0.5rem;
  font-size: 0.8rem;
  color: #777;
}

.post-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: auto;
}

.post-card__tag {
  font-size: 0.75rem;
  color: #00adef;
  background: #e8f6fd;
  padding: 2px 10px;
  border-radius: 12px;
  text-decoration: none;
}

.post-card__tag:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 560px) {
  .post-grid { grid-template-columns: 1fr; }
}
</style>

{% else %}

<section>
  {% if page.url == "/" | url %}{% endif %}
  {% for post in postslist %}
    {% if not post.data.hide %}

    <article class="post">
      <h3>
        <a href="{{ post.url | url }}">
          {% if post.data.title %}
            {{ post.data.title }}
          {% else %}
                        Untitled
                    {% endif %}
        </a>
      </h3>
      {% if post.data.summary %}
        <p class="text-lg text-gray-500 mb-3">
          {{ post.data.summary }}
        </p>
      {% endif %}

      <div class="card__tags">
        <time>{{ post.data.date | readableDate }}</time> 
        <span class="post-author">by {{ post.data.author }}</span>

        {% for tag in post.data.tags %}
          {% if tag != 'post' %}
            <a href={{ '/en/tags/' | url }}{{ tag | slug }}/>{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </article>
    {% endif %}
  {% endfor %}
</section>

{% endif %}