{% set isBlogPage = (page.url == '/en/posts/') %}

{% if isBlogPage %}

<section class="post-grid">
  {% for post in postslist %}
    {% if not post.data.hide %}
      <article class="post-card">
        <a href="{{ post.url | url }}" class="post-card__media" tabindex="-1" aria-hidden="true">
          {% if post.data.image %}
            <img src="{{ post.data.image | url }}" alt="" loading="lazy">
          {% endif %}
        </a>

        <h3 class="post-card__title">
          <a href="{{ post.url | url }}">
            {% if post.data.title %}{{ post.data.title }}{% else %}Untitled{% endif %}
          </a>
        </h3>

        {% if post.data.description %}
          <p class="post-card__summary">{{ post.data.description }}</p>
        {% endif %}

        <p class="post-card__meta">
          <time>{{ post.data.date | readableDate }}</time>
          {% if post.data.author %}<span class="post-author">&middot; {{ post.data.author }}</span>{% endif %}
        </p>

        <div class="post-card__tags">
          {% for tag in post.data.tags %}
            {% if tag != 'post' %}
              <a href="{{ '/en/tags/' | url }}{{ tag | slug }}/" class="post-card__tag">{{ tag }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </article>
    {% endif %}
  {% endfor %}
</section>

<nav class="post-pager" id="post-pager" aria-label="Blog pages"></nav>

<style>
.post-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2rem 1.5rem;
  margin: 1.5rem 0 2rem;
}

.post-card {
  display: flex;
  flex-direction: column;
}

.post-card[hidden] {
  display: none;
}

.post-card__media {
  display: block;
  aspect-ratio: 3 / 2;
  background: #e8f6fd;
  overflow: hidden;
}

.post-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.25s ease;
}

.post-card:hover .post-card__media img {
  transform: scale(1.04);
}

.post-card__title {
  margin: 0.75rem 0 0.4rem;
  font-size: 1.15rem;
  line-height: 1.3;
  font-weight: 700;
}

.post-card__title a {
  color: inherit;
  text-decoration: none;
  font-weight: inherit;
}

.post-card__title a:hover {
  color: #00adef;
  text-decoration: underline;
}

.post-card__summary {
  margin: 0 0 0.5rem;
  font-size: 0.9rem;
  line-height: 1.45;
  color: #555;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card__meta {
  margin: 0 0 0.5rem;
  font-size: 0.8rem;
  color: #777;
}

.post-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-top: auto;
}

.post-card__tag {
  font-size: 0.75rem;
  color: #00adef;
  background: #e8f6fd;
  padding: 2px 10px;
  border-radius: 12px;
  text-decoration: none;
}

.post-card__tag:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 560px) {
  .post-grid { grid-template-columns: 1fr; }
}

.post-pager {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.4rem;
  margin: 0 0 2rem;
}

.post-pager button {
  min-width: 2.25rem;
  padding: 0.4rem 0.7rem;
  font: inherit;
  font-size: 0.9rem;
  color: #00adef;
  background: #fff;
  border: 1px solid #b3e6fa;
  border-radius: 6px;
  cursor: pointer;
}

.post-pager button:hover:not(:disabled) {
  border-color: #00adef;
  background: #e8f6fd;
}

.post-pager button[aria-current="page"] {
  background: #00adef;
  border-color: #00adef;
  color: #fff;
  font-weight: 700;
}

.post-pager button:disabled {
  opacity: 0.4;
  cursor: default;
}
</style>

<script>
(function () {
  var PER_PAGE = 15;
  var cards = Array.prototype.slice.call(document.querySelectorAll('.post-grid .post-card'));
  var pager = document.getElementById('post-pager');
  var grid = document.querySelector('.post-grid');
  if (!pager || !grid || cards.length <= PER_PAGE) return;

  var totalPages = Math.ceil(cards.length / PER_PAGE);
  var current = 1;

  function getStartPage() {
    var n = parseInt(new URLSearchParams(location.search).get('page'), 10);
    return n >= 1 && n <= totalPages ? n : 1;
  }

  function btn(label, page, opts) {
    var b = document.createElement('button');
    b.type = 'button';
    b.textContent = label;
    opts = opts || {};
    if (opts.disabled) b.disabled = true;
    if (opts.current) b.setAttribute('aria-current', 'page');
    b.addEventListener('click', function () { show(page, true); });
    return b;
  }

  function show(page, scroll) {
    current = page;
    cards.forEach(function (card, i) {
      card.hidden = Math.floor(i / PER_PAGE) + 1 !== page;
    });

    pager.innerHTML = '';
    pager.appendChild(btn('Previous', page - 1, { disabled: page === 1 }));
    for (var p = 1; p <= totalPages; p++) {
      pager.appendChild(btn(String(p), p, { current: p === page }));
    }
    pager.appendChild(btn('Next', page + 1, { disabled: page === totalPages }));

    var url = new URL(location.href);
    if (page === 1) url.searchParams.delete('page');
    else url.searchParams.set('page', page);
    history.replaceState(null, '', url);

    if (scroll) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  show(getStartPage(), false);
})();
</script>

{% else %}

<section>
  {% if page.url == "/" | url %}{% endif %}
  {% for post in postslist %}
    {% if not post.data.hide %}

    <article class="post">
      <h3>
        <a href="{{ post.url | url }}">
          {% if post.data.title %}
            {{ post.data.title }}
          {% else %}
                        Untitled
                    {% endif %}
        </a>
      </h3>
      {% if post.data.summary %}
        <p class="text-lg text-gray-500 mb-3">
          {{ post.data.summary }}
        </p>
      {% endif %}

      <div class="card__tags">
        <time>{{ post.data.date | readableDate }}</time> 
        <span class="post-author">by {{ post.data.author }}</span>

        {% for tag in post.data.tags %}
          {% if tag != 'post' %}
            <a href={{ '/en/tags/' | url }}{{ tag | slug }}/>{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </article>
    {% endif %}
  {% endfor %}
</section>

{% endif %}