<section class="pp-section">
  <h3>Projects</h3>
  <div class="pp-grid">
    {% for project in projects %}
      <article class="pp-card">
        {% if project.image %}
          <a href="{{ project.url | url }}" class="pp-card__media" tabindex="-1" aria-hidden="true">
            <img src="{{ project.image | url }}" alt="" loading="lazy">
          </a>
        {% endif %}
        <div class="pp-card__body">
          <h4 class="pp-card__title">
            <a href="{{ project.url | url }}">{{ project.title }}</a>
            {% if project.status %}<span class="pp-card__badge">{{ project.status }}</span>{% endif %}
          </h4>
          <p class="pp-card__desc">{{ project.description }}</p>
          {% if project.repo %}
            <a href="{{ project.repo }}" class="pp-card__link" target="_blank" rel="noopener">View on GitHub →</a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <p class="pp-readmore">
    <a href="https://github.com/semanticClimate" target="_blank" rel="noopener">Read more →</a>
  </p>
</section>

<section class="pp-section">
  <h3>Publications</h3>
  <div class="pp-grid">
    {% for pub in publications | sort(true, true, "date") %}
      <article class="pp-card">
        {% if pub.image %}
          <a href="{{ pub.url | url }}" class="pp-card__media" tabindex="-1" aria-hidden="true">
            <img src="{{ pub.image | url }}" alt="" loading="lazy">
          </a>
        {% endif %}
        <div class="pp-card__body">
          <h4 class="pp-card__title"><a href="{{ pub.url | url }}">{{ pub.title }}</a></h4>
          <p class="pp-card__desc">{{ pub.authors }} &middot; {{ pub.date }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
  <p class="pp-readmore">
    <a href="{{ '/en/posts/' | url }}">Read more →</a>
  </p>
</section>

<style>
.pp-section {
  margin: 1.5rem 0 2rem;
}

.pp-section h3 {
  margin-bottom: 0.75rem;
}

.pp-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
}

.pp-card {
  display: flex;
  flex-direction: column;
  border: 1px solid #b3e6fa;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2px 6px rgba(0, 173, 239, 0.16);
  transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
}

.pp-card:hover {
  border-color: #00adef;
  box-shadow: 0 6px 16px rgba(0, 173, 239, 0.22);
  transform: translateY(-2px);
}

.pp-card__media {
  display: block;
  aspect-ratio: 3 / 2;
  background: #f3f3f3;
  overflow: hidden;
}

.pp-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pp-card__body {
  padding: 0.85rem 1rem 1rem;
  flex: 1;
}

.pp-card__title {
  margin: 0 0 0.4rem;
  font-size: 1.1rem;
  line-height: 1.3;
}

.pp-card__title a {
  color: inherit;
  text-decoration: none;
}

.pp-card__title a:hover {
  color: #00adef;
  text-decoration: underline;
}

.pp-card__badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 400;
  text-transform: uppercase;
  background: #eaf3de;
  color: #3b6d11;
  padding: 2px 8px;
  border-radius: 12px;
  margin-left: 8px;
  vertical-align: middle;
}

.pp-card__desc {
  margin: 0 0 0.5rem;
  font-size: 0.9rem;
  line-height: 1.5;
  color: #555;
}

.pp-card__link {
  font-size: 0.85rem;
  font-weight: 600;
  color: #185fa5;
  text-decoration: none;
}

.pp-card__link:hover {
  text-decoration: underline;
}

.pp-readmore {
  margin-top: 0.75rem;
}

.pp-readmore a {
  font-size: 1.1rem;
  font-weight: 600;
  color: #00adef;
  text-decoration: none;
}

.pp-readmore a:hover {
  text-decoration: underline;
}

@media (max-width: 600px) {
  .pp-grid {
    grid-template-columns: 1fr;
  }
}
</style>