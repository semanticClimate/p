<section class="events-grid">
    {% for post in eventslist %}
        <article class="event-card {% if post.data.featured %}event-card--featured{% endif %}">
            {% if post.data.image %}
                <div class="event-card__media">
                    <img src="{{ post.data.image | url }}" alt="" loading="lazy">
                </div>
            {% endif %}

            <div class="event-card__body">
                <time class="event-card__date">
                    {{ post.data.date | readableDate }}
                    {% if post.data.endDate %}
                        &ndash; {{ post.data.endDate | readableDate }}
                    {% endif %}
                </time>

                <h3 class="event-card__title">
                    <a href="{{ post.url | url }}" class="event-card__link">
                        {{ post.data.title or "Untitled" }}
                    </a>
                </h3>

                {% if post.data.description %}
                    <p class="event-card__desc">{{ post.data.description }}</p>
                {% endif %}

                {% if post.data.tags %}
                    <ul class="event-card__tags">
                        {% for tag in post.data.tags %}
                            {% if tag != "event" %}
                                <li><a href="{{ '/en/tags/' | url }}{{ tag | slug }}/">{{ tag }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </article>
    {% endfor %}
</section>

<style>
.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.5rem;
  margin: 1.5rem 0;
}

.event-card {
  position: relative;               /* anchor for the stretched title link */
  border: 1px solid #e2e2e2;
  border-radius: 8px;
  overflow: hidden;
  transition: box-shadow 0.15s ease, transform 0.15s ease;
}

.event-card:hover {
  box-shadow: 0 4px 14px rgba(21, 224, 174, 0.08);
  transform: translateY(-2px);
}

.event-card--featured {
  border-color: #8a9794;
  border-width: 2px;
}

.event-card__media {
  aspect-ratio: 16 / 9;
  background: #f3f3f3;
}

.event-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.event-card__body {
  padding: 1rem;
}

.event-card__date {
  font-size: 0.8rem;
  color: #666;
}

.event-card__title {
  margin: 0.25rem 0;
}

.event-card__link {
  color: inherit;
  text-decoration: none;
}

.event-card__link::after {          /* makes the whole card clickable */
  content: "";
  position: absolute;
  inset: 0;
}

.event-card__link:hover {
  color: #00adef;
}

.event-card__desc {
  font-size: 0.9rem;
  color: #444;
}

.event-card__tags {
  display: flex;
  gap: 6px;
  list-style: none;
  padding: 0;
  margin-top: 0.5rem;
  flex-wrap: wrap;
}

.event-card__tags li {
  position: relative;               /* sits above the stretched link */
  z-index: 2;
}

.event-card__tags a {
  display: block;
  font-size: 0.7rem;
  background: #f0f0f0;
  color: inherit;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: capitalize;
  text-decoration: none;
}

.event-card__tags a:hover {
  background: #e8f6fd;
  color: #00adef;
}
</style>