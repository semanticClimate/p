<section class="events-grid">
    {% for post in eventslist %}
        <article class="event-card {% if post.data.featured %}event-card--featured{% endif %}">
            {% if post.data.image %}
                <div class="event-card__media">
                    <img src="{{ post.data.image | url }}" alt="" loading="lazy">
                </div>
            {% endif %}

            <div class="event-card__body">
                <time class="event-card__date">
                    {{ post.data.date | readableDate }}
                    {% if post.data.endDate %}
                        &ndash; {{ post.data.endDate | readableDate }}
                    {% endif %}
                </time>

                <h3 class="event-card__title">
                    <a href="{{ post.url | url }}" class="event-card__link">
                        {{ post.data.title or "Untitled" }}
                    </a>
                </h3>

                {% if post.data.description %}
                    <p class="event-card__desc">{{ post.data.description }}</p>
                {% endif %}

                {% if post.data.tags %}
                    <ul class="event-card__tags">
                        {% for tag in post.data.tags %}
                            {% if tag != "event" %}
                                <li><a href="{{ '/en/tags/' | url }}{{ tag | slug }}/">{{ tag }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </article>
    {% endfor %}
</section>

{% if page.url == '/en/events/' %}

<style>
.events-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
  margin: 1.5rem 0;
}

/* Card: image on top, text below, always */
.events-grid .event-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  grid-template-columns: none;
  border: 1px solid #e2e2e2;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  transition: box-shadow 0.15s ease, transform 0.15s ease;
}

.events-grid .event-card:hover {
  box-shadow: 0 4px 14px rgba(0, 173, 239, 0.18);
  transform: translateY(-2px);
}

.events-grid .event-card--featured {
  border-color: #8a9794;
  border-width: 2px;
}

/* Full image, full card width, nothing cropped */
.events-grid .event-card__media {
  display: block;
  float: none;
  flex: none;
  width: 100%;
  max-width: none;
  margin: 0;
  background: #fff;
}

.events-grid .event-card__media img {
  display: block;
  width: 100%;
  max-width: none;
  height: auto;
  object-fit: contain;
}

.events-grid .event-card__body {
  flex: 1;
  width: 100%;
  padding: 1rem;
}

.events-grid .event-card__date {
  font-size: 0.8rem;
  color: #666;
}

.events-grid .event-card__title {
  margin: 0.25rem 0 0.5rem;
  font-size: 1.15rem;
  line-height: 1.3;
}

.events-grid .event-card__link {
  font-size: 1.15rem;
  line-height: 1.3;
  font-weight: 700;
  color: inherit;
  text-decoration: none;
}

.events-grid .event-card__link::after {
  content: "";
  position: absolute;
  inset: 0;
}

.events-grid .event-card__link:hover {
  color: #00adef;
}

.events-grid .event-card__desc {
  font-size: 0.9rem;
  color: #444;
}

.events-grid .event-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  list-style: none;
  padding: 0;
  margin: 0.5rem 0 0;
}

.events-grid .event-card__tags li {
  position: relative;
  z-index: 2;
}

.events-grid .event-card__tags a {
  display: block;
  font-size: 0.7rem;
  background: #f0f0f0;
  color: inherit;
  padding: 2px 8px;
  border-radius: 12px;
  text-transform: capitalize;
  text-decoration: none;
}

.events-grid .event-card__tags a:hover {
  background: #e8f6fd;
  color: #00adef;
}
</style>
{% endif %}